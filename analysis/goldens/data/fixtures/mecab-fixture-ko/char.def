# Character categories of the Korean fixture dictionary, written for the
# lattice tokenizer tests.
DEFAULT         0 1 0
SPACE           0 1 0
HANJA           0 0 1
SYMBOL          1 1 0
NUMERIC         1 1 0
ALPHA           1 1 0
HANGUL          0 1 2
HANJANUMERIC    1 1 0
0x0020 SPACE
0x0021..0x002F SYMBOL
0x0030..0x0039 NUMERIC
0x003A..0x0040 SYMBOL
0x0041..0x005A ALPHA
0x005B..0x0060 SYMBOL
0x0061..0x007A ALPHA
0x007B..0x007E SYMBOL
0xAC00..0xD7A3  HANGUL
0x1100..0x11FF  HANGUL  # conjoining jamo
0x3130..0x318F  HANGUL  # compatibility jamo
0x4E00..0x9FFF  HANJA
0xF900..0xFAFF  HANJA
0x4E00 HANJANUMERIC HANJA
0x4E8C HANJANUMERIC HANJA
0x4E09 HANJANUMERIC HANJA
