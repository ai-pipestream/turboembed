<?xml version="1.0" encoding="UTF-8"?>
<!-- Every generator a descriptor can name except the cache, each once. -->
<featureGenerators name="everything">
  <generator class="opennlp.tools.util.featuregen.TokenFeatureGeneratorFactory"><bool name="lowercase">false</bool></generator>
  <generator class="opennlp.tools.util.featuregen.TokenClassFeatureGeneratorFactory"><bool name="wordAndClass">false</bool></generator>
  <generator class="opennlp.tools.util.featuregen.TokenPatternFeatureGeneratorFactory"/>
  <generator class="opennlp.tools.util.featuregen.PrefixFeatureGeneratorFactory"><int name="length">3</int></generator>
  <generator class="opennlp.tools.util.featuregen.SuffixFeatureGeneratorFactory"><int name="length">6</int></generator>
  <generator class="opennlp.tools.util.featuregen.CharacterNgramFeatureGeneratorFactory">
    <int name="min">2</int>
    <int name="max">3</int>
  </generator>
  <generator class="opennlp.tools.util.featuregen.BigramNameFeatureGeneratorFactory"/>
  <generator class="opennlp.tools.util.featuregen.TrigramNameFeatureGeneratorFactory"/>
  <generator class="opennlp.tools.util.featuregen.SentenceFeatureGeneratorFactory"><bool name="begin">FALSE</bool></generator>
  <generator class="opennlp.tools.util.featuregen.DocumentBeginFeatureGeneratorFactory"/>
  <generator class="opennlp.tools.util.featuregen.PreviousMapFeatureGeneratorFactory"/>
  <generator class="opennlp.tools.util.featuregen.PosTaggerFeatureGeneratorFactory"/>
  <generator class="opennlp.tools.util.featuregen.DefinitionFeatureGeneratorFactory"/>
  <generator class="opennlp.tools.util.featuregen.BrownClusterTokenFeatureGeneratorFactory"><str name="dict">brown.cluster</str></generator>
  <generator class="opennlp.tools.util.featuregen.BrownClusterTokenClassFeatureGeneratorFactory"><str name="dict">brown.cluster</str></generator>
  <generator class="opennlp.tools.util.featuregen.BrownClusterBigramFeatureGeneratorFactory"><str name="dict">brown.cluster</str></generator>
  <generator class="opennlp.tools.util.featuregen.WordClusterFeatureGeneratorFactory">
    <str name="dict">word.cluster</str>
    <bool name="lowerCase">true</bool>
  </generator>
  <generator class="opennlp.tools.util.featuregen.WordClusterFeatureGeneratorFactory">
    <str name="dict">word.cluster</str>
    <bool name="lowerCase">false</bool>
  </generator>
  <generator class="opennlp.tools.util.featuregen.DictionaryFeatureGeneratorFactory"><str name="dict">names.dictionary</str></generator>
</featureGenerators>
