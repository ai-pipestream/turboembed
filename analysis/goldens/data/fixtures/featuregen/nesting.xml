<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows over several generators, an aggregate of three (whose second
     and third children write their features twice), a cache inside the
     tree, a negative window length and cache="TRUE" on the root. -->
<featureGenerators cache="TRUE">
  <generator class="opennlp.tools.util.featuregen.WindowFeatureGeneratorFactory">
    <int name="prevLength">1</int>
    <int name="nextLength">3</int>
    <generator class="opennlp.tools.util.featuregen.TokenFeatureGeneratorFactory"/>
    <generator class="opennlp.tools.util.featuregen.PrefixFeatureGeneratorFactory"><int name="length">2</int></generator>
  </generator>
  <generator class="opennlp.tools.util.featuregen.AggregatedFeatureGeneratorFactory">
    <generator class="opennlp.tools.util.featuregen.TokenFeatureGeneratorFactory"><bool name="lowercase">false</bool></generator>
    <generator class="opennlp.tools.util.featuregen.SuffixFeatureGeneratorFactory"><int name="length">1</int></generator>
    <generator class="opennlp.tools.util.featuregen.DefinitionFeatureGeneratorFactory"/>
  </generator>
  <generator class="opennlp.tools.util.featuregen.CachedFeatureGeneratorFactory">
    <generator class="opennlp.tools.util.featuregen.WindowFeatureGeneratorFactory">
      <int name="prevLength">-1</int>
      <int name="nextLength">1</int>
      <generator class="opennlp.tools.util.featuregen.TokenClassFeatureGeneratorFactory"/>
    </generator>
  </generator>
  <generator class="opennlp.tools.util.featuregen.WindowFeatureGeneratorFactory">
    <int name="prevLength">2</int>
    <int name="nextLength">0</int>
    <generator class="opennlp.tools.util.featuregen.PosTaggerFeatureGeneratorFactory"/>
  </generator>
  <generator class="opennlp.tools.util.featuregen.AggregatedFeatureGeneratorFactory">
    <generator class="opennlp.tools.util.featuregen.BigramNameFeatureGeneratorFactory"/>
  </generator>
</featureGenerators>
