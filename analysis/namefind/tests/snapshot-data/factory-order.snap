case 0: defaults [UsaPhoneNum, Email] config [] -> ["PHONE_NUM", "EMAIL"]
case 0 nodefaults -> []
case 1: defaults [UsaPhoneNum, Email] config [("PHONE_NUM", [Tokens(TokensPattern([Tok { tests: [Text == "call"], negated: false, min: 1, max: Some(1) }]))])] -> ["PHONE_NUM", "EMAIL"]
case 1 nodefaults -> ["PHONE_NUM"]
case 2: defaults [Email, Url] config [("EMAIL", [Tokens(TokensPattern([Tok { tests: [Text == "call"], negated: false, min: 1, max: Some(1) }]))])] -> ["EMAIL", "URL"]
case 2 nodefaults -> ["EMAIL"]
case 3: defaults [Url] config [("PHONE_NUM", [Tokens(TokensPattern([Tok { tests: [Text == "x"], negated: false, min: 1, max: Some(1) }]))])] -> ["URL", "PHONE_NUM"]
case 3 nodefaults -> ["PHONE_NUM"]
case 4: defaults [Email, Url] config [("EMAIL", [Tokens(TokensPattern([Tok { tests: [Text == "call"], negated: false, min: 1, max: Some(1) }]))]), ("URL", [Tokens(TokensPattern([Tok { tests: [Text == "call"], negated: false, min: 1, max: Some(1) }]))])] -> ["EMAIL", "URL"]
case 4 nodefaults -> ["EMAIL", "URL"]
case 5: defaults [UsaPhoneNum, Email] config [("WORD", [Tokens(TokensPattern([Tok { tests: [Text == "y"], negated: false, min: 1, max: Some(1) }]))])] -> ["PHONE_NUM", "EMAIL", "WORD"]
case 5 nodefaults -> ["WORD"]
case 6: defaults [Url] config [("PHONE_NUM", [Tokens(TokensPattern([Tok { tests: [Text == "y"], negated: false, min: 1, max: Some(1) }]))]), ("EMAIL", [Tokens(TokensPattern([Tok { tests: [Text == "call"], negated: false, min: 1, max: Some(1) }]))])] -> ["URL", "PHONE_NUM", "EMAIL"]
case 6 nodefaults -> ["PHONE_NUM", "EMAIL"]
case 7: defaults [Url] config [] -> ["URL"]
case 7 nodefaults -> []
case 8: defaults [Email, Url] config [] -> ["EMAIL", "URL"]
case 8 nodefaults -> []
case 9: defaults [Email, Mgrs] config [("URL", [Tokens(TokensPattern([Tok { tests: [Text == "call"], negated: false, min: 1, max: Some(1) }]))])] -> ["EMAIL", "MGRS", "URL"]
case 9 nodefaults -> ["URL"]
case 10: defaults [Mgrs, DegreesMinSecLatLon] config [] -> ["MGRS", "DEGREES_MIN_SEC_LAT_LON"]
case 10 nodefaults -> []
case 11: defaults [UsaPhoneNum, Email, Mgrs] config [("URL", [Tokens(TokensPattern([Tok { tests: [Text == "x"], negated: false, min: 1, max: Some(1) }]))]), ("EMAIL", [Tokens(TokensPattern([Tok { tests: [Text == "call"], negated: false, min: 1, max: Some(1) }]))])] -> ["PHONE_NUM", "EMAIL", "MGRS", "URL"]
case 11 nodefaults -> ["URL", "EMAIL"]
