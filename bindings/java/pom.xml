<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ai.pipestream</groupId>
  <artifactId>turbo</artifactId>
  <version>2.0.0-alpha.0</version>
  <packaging>jar</packaging>

  <name>Pipestream Turbo</name>
  <description>JDK 25 foreign-function binding for libturbo: one API over every inference provider.</description>
  <url>https://github.com/ai-pipestream/turboembed</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <!-- Path to libturbo for the tests; override with -Dturbo.library=... -->
    <turbo.library>${project.basedir}/../../target/debug/libturbo.so</turbo.library>
    <!-- Mock bundles for the tests; override with -Dturbo.bundles=... -->
    <turbo.bundles>${project.basedir}/../../testdata/bundles/mock</turbo.bundles>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- Native access must be granted explicitly; the binding declares
               it and the tests run under the strictest setting. -->
          <argLine>-Xmx2g --enable-native-access=ALL-UNNAMED --illegal-native-access=deny</argLine>
          <systemPropertyVariables>
            <turbo.library>${turbo.library}</turbo.library>
            <turbo.bundles>${turbo.bundles}</turbo.bundles>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
