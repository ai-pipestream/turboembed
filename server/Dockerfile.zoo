# syntax=docker/dockerfile:1
#
# The model zoo image (docs/zoo-container.md): turbo-kserve serving its
# model catalog in zoo mode (docs/grpc-catalog.md, Zoo mode) and the demo
# page (docs/demo.md) in front of it, built from the tree on Docker
# Hardened Images (dhi.io). Building needs `docker login dhi.io`. The
# build context is the repository root:
#
#   docker build -f server/Dockerfile.zoo -t turbo-zoo .
#
# The image holds no model. The zoo home is the /zoo volume; a model is
# fetched from its origin, or from the store named by
# TURBO_KSERVE_CATALOG_STORE, only when a user it is permitted to reads it
# or installs it. gRPC listens on 0.0.0.0:8081, the page on 0.0.0.0:8080.
# docker-compose.zoo.yml runs it beside RustFS as the store.
#
# Both bases are pinned by the digest of their multi-arch index. The
# runtime stage has no shell, no curl and no package manager.

ARG BUILD_BASE=dhi.io/rust:1.99-debian13-dev@sha256:6d78c1696e4745d1e006193ddef94d354094c890a284fa8ad6b954a8777eb63d
ARG RUNTIME_BASE=dhi.io/static:20250419-glibc-debian13@sha256:e29f8b6739566855c2e3ec2786002553b26a5b68a8c6ec7337962c40866aaf71

FROM ${BUILD_BASE} AS build
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Bound build parallelism; callers may raise it on dedicated builders.
ARG CARGO_BUILD_JOBS=2
ENV CARGO_HOME=/usr/local/cargo

WORKDIR /src
COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target,sharing=locked \
    set -eux; \
    cargo build --locked --release -p turbo-kserve -p turbo-kserve-demo; \
    for bin in target/release/turbo-kserve target/release/turbo-kserve-demo; do \
        ldd "$bin"; \
        if ldd "$bin" | grep -q 'not found'; then \
            echo "$bin links a missing library" >&2; exit 1; \
        fi; \
    done; \
    multiarch="$(g++ -dumpmachine)"; \
    mkdir -p /out/turbo/bin /out/turbo/licenses "/out/lib/${multiarch}" /out/zoo; \
    cp target/release/turbo-kserve target/release/turbo-kserve-demo /out/turbo/bin/; \
    ln -s turbo-kserve /out/turbo/bin/zoo-start; \
    ln -s turbo-kserve /out/turbo/bin/zoo-health; \
    ln -s turbo-kserve /out/turbo/bin/zoo-bucket; \
    cp -a "/usr/lib/${multiarch}/libstdc++.so.6"* "/out/lib/${multiarch}/"; \
    cp LICENSE /out/turbo/licenses/LICENSE; \
    cp NOTICE /out/turbo/licenses/NOTICE

FROM ${RUNTIME_BASE}
# Only the built binaries, libstdc++ for the backends' C++ host side, and
# the CA bundle from the build stage enter the shell-free runtime image.
COPY --from=build /out/turbo /opt/turbo
COPY --from=build /out/lib/ /usr/lib/
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build --chown=10001:10001 /out/zoo /zoo

ENV PATH=/opt/turbo/bin:${PATH} \
    TURBO_KSERVE_LISTEN=0.0.0.0:8081 \
    TURBO_KSERVE_CATALOG_DIR=/zoo \
    TURBO_KSERVE_ZOO=1 \
    TURBO_DEMO_LISTEN=0.0.0.0:8080 \
    TURBO_DEMO_ALLOW=/turbo.training.v1.TurboCatalogService/RecordLicenceAcceptance,/turbo.training.v1.TurboCatalogService/RevokeLicenceAcceptance,/turbo.training.v1.TurboCatalogService/InstallModel \
    NVIDIA_VISIBLE_DEVICES=void

LABEL org.opencontainers.image.title="turbo-zoo" \
      org.opencontainers.image.description="turboembed's model zoo: the model catalog over gRPC and a page to browse, accept and install models" \
      org.opencontainers.image.source="https://github.com/ai-pipestream/turboembed" \
      org.opencontainers.image.licenses="Apache-2.0"

USER 10001:10001
VOLUME ["/zoo"]
EXPOSE 8080 8081
STOPSIGNAL SIGTERM
# The server answers SERVING and the page answers, over HTTPS when the
# page serves it (`turbo-kserve zoo-health`).
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 CMD ["turbo-kserve", "zoo-health"]
ENTRYPOINT ["turbo-kserve", "zoo-start"]
