<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>
  <groupId>ai.pipestream.demo</groupId>
  <artifactId>turbo-demo-web</artifactId>
  <version>0.1.0</version>
  <name>Turbo web demo (Spring Boot)</name>
  <description>A Turbo inference server over the Java binding: a JSON REST API, the KServe Open Inference Protocol v2 REST surface, and a page that shows both</description>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <springdoc.version>2.8.17</springdoc.version>
    <!-- libturbo for tests; the app reads turbo.library the same way. -->
    <turbo.library>${project.basedir}/../../target/debug/libturbo.so</turbo.library>
    <turbo.bundle>${project.basedir}/../../testdata/bundles/mock/embedding</turbo.bundle>
    <turbo.generate-bundle>${project.basedir}/../../testdata/bundles/mock/generative</turbo.generate-bundle>
    <turbo.rerank-bundle>${project.basedir}/../../testdata/bundles/mock/reranker</turbo.rerank-bundle>
    <turbo.classify-bundle>${project.basedir}/../../testdata/bundles/mock/classifier</turbo.classify-bundle>
    <turbo.token-classify-bundle>${project.basedir}/../../testdata/bundles/mock/token-classifier</turbo.token-classify-bundle>
    <turbo.generic-bundle>${project.basedir}/../../testdata/bundles/mock/generic</turbo.generic-bundle>
    <!-- The mock bundles carry no tokenizer.json, so /api/v1/tokenize uses this one. -->
    <turbo.tokenizer-bundle>${project.basedir}/../../testdata/bundles/minilm-tokenizer</turbo.tokenizer-bundle>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.pipestream</groupId>
      <artifactId>turbo</artifactId>
      <version>2.0.0-alpha.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <jvmArguments>--enable-native-access=ALL-UNNAMED -Dturbo.library=${turbo.library}</jvmArguments>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Xmx2g --enable-native-access=ALL-UNNAMED -Dturbo.library=${turbo.library}</argLine>
          <systemPropertyVariables>
            <turbo.bundle>${turbo.bundle}</turbo.bundle>
            <turbo.generate-bundle>${turbo.generate-bundle}</turbo.generate-bundle>
            <turbo.rerank-bundle>${turbo.rerank-bundle}</turbo.rerank-bundle>
            <turbo.classify-bundle>${turbo.classify-bundle}</turbo.classify-bundle>
            <turbo.token-classify-bundle>${turbo.token-classify-bundle}</turbo.token-classify-bundle>
            <turbo.generic-bundle>${turbo.generic-bundle}</turbo.generic-bundle>
            <turbo.tokenizer-bundle>${turbo.tokenizer-bundle}</turbo.tokenizer-bundle>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
